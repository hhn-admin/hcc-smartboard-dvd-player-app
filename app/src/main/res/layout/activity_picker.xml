<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="24dp"
    android:paddingEnd="40dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/picker_title"
        android:textColor="@color/on_surface"
        android:textSize="44sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/step_plug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/step_row_bg"
        android:gravity="center_vertical"
        android:minHeight="104dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/step_plug_number"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/step_number_bg"
            android:duplicateParentState="true"
            android:gravity="center"
            android:text="@string/step_number_one"
            android:textColor="@color/step_number_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="@string/plug_in_dvd_capture_card"
            android:textColor="@color/on_surface"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/step_tap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/step_row_bg"
        android:gravity="center_vertical"
        android:minHeight="104dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/step_tap_number"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/step_number_bg"
            android:duplicateParentState="true"
            android:gravity="center"
            android:text="@string/step_number_two"
            android:textColor="@color/step_number_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step_tap_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="@string/step_tap"
            android:textColor="@color/on_surface"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/notice"
        android:textSize="24sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/permission_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/permission_note"
        android:textColor="@color/on_surface_muted"
        android:textSize="22sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/permission_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="96dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/allow_access"
        android:textSize="24sp"
        android:visibility="gone"
        app:cornerRadius="18dp" />

    <!--
      The board's USB ports are on the front bezel at the physical bottom-left,
      under the screen. This block stays on that corner (absolute left, not
      "start") and the arrow points down-left toward those ports.
    -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="bottom|left"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|left"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/empty_plug"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_usb_plug" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:gravity="left"
                android:text="@string/plug_in_dvd_capture_card"
                android:textColor="@color/on_surface"
                android:textSize="40sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/empty_arrow"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_down_left" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sources"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />
</LinearLayout>
